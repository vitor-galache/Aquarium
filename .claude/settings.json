{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(git worktree:*)",
      "Bash(npm ci:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run build:*)",
      "Bash(npm run tauri:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(gh api -X PUT repos/vitor-galache/Aquarium/branches/main/protection:*)",
      "Bash(gh api -X DELETE repos/vitor-galache/Aquarium/branches/main/protection:*)",
      "Bash(gh api -X PUT repos/vitor-galache/notesea/branches/main/protection:*)",
      "Bash(gh api -X DELETE repos/vitor-galache/notesea/branches/main/protection:*)"
    ]
  }
}
